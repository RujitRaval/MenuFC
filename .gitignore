# ─── Secrets — NEVER commit ──────────────────────────────────────────────
# The football-data.org key lives ONLY as a Cloudflare Worker secret.
# These files can hold local secrets for development — keep them out of git.
.dev.vars
.dev.vars.*
.env
.env.*
*.secret
secrets.*

# ─── Cloudflare / Wrangler ───────────────────────────────────────────────
.wrangler/
**/.wrangler/
# wrangler.toml is safe to commit (no secrets) and IS tracked.

# ─── Python (client) ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ─── Node (worker tooling) ───────────────────────────────────────────────
node_modules/
npm-debug.log*

# ─── Build / release artifacts ───────────────────────────────────────────
dist/

# ─── Xcode (native app) ──────────────────────────────────────────────────
# MenuFC.xcodeproj is generated from project.yml by `xcodegen generate`.
app/build/
app/MenuFC.xcodeproj/
*.xcuserstate
xcuserdata/
DerivedData/

# ─── macOS ───────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble

# ─── Internal scaffolding (NOT part of the product) ──────────────────────
# Claude Code prompts + private launch checklist — keep local, out of the public repo.
/BUILD_PROMPT.md
/DIRECT_DIST_PROMPT.md
/LOCALTIME_PROMPT.md
/TRADEMARK_PROMPT.md
/START_HERE.md

# Local agent/editor settings
.claude/
